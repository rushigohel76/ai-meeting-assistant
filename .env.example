# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mom
# MEETING_BAAS_API_KEY=replace-with-meeting-baas-api-key
# MEETING_BAAS_BASE_URL=https://api.meetingbaas.com
# # Optional. If omitted, the backend uses MEETING_BAAS_API_KEY as the callback secret.
# MEETING_BAAS_WEBHOOK_SECRET=replace-with-meeting-baas-webhook-secret
# # Must be publicly reachable by Meeting BaaS; use ngrok or similar for local development.
# WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app
# DEEPGRAM_API_KEY=replace-with-deepgram-api-key
# DEEPGRAM_BASE_URL=https://api.deepgram.com
# MAX_TRANSCRIPTION_AUDIO_DURATION_SECONDS=10800
# ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_OUTPUT_TOKENS=2048
# GEMINI_API_KEY=replace-with-gemini-api-key
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MAX_OUTPUT_TOKENS=2048
# MAX_SUMMARY_CHUNK_CHARS=60000
# JWT_SECRET_KEY=replace-with-a-long-random-secret
# RESEND_API_KEY=replace-with-resend-api-key
# RESEND_BASE_URL=https://api.resend.com
# RESEND_FROM_EMAIL="MOM <onboarding@resend.dev>"
# FRONTEND_BASE_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
